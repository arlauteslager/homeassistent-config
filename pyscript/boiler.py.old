# /config/pyscript/boiler.py

from datetime import datetime, time

DAG_TIMER = "00:30:00"


def pv_zonnig_vermogen():
    maart_ref = 2050
    schaal = maart_ref / 2150

    nu = datetime.now()
    maand = int(nu.month)
    dag = int(nu.day)

    basis_waardes = {
        1: 900,
        2: 1500,
        3: 1700,
        4: 1900,
        5: 2000,
        6: 2000,
        7: 2000,
        8: 2000,
        9: 1900,
        10: 1400,
        11: 1000,
        12: 800,
        # 1: 1150,
        # 2: 1600,
        # 3: 2150,
        # 4: 2500,
        # 5: 2700,
        # 6: 2750,
        # 7: 2600,
        # 8: 2350,
        # 9: 2000,
        # 10: 1500,
        # 11: 1000,
        # 12: 800,
    }

    begin = round(basis_waardes[maand] * schaal)
    eind = round(basis_waardes[1 if maand == 12 else maand + 1] * schaal)

    if maand in [1, 3, 5, 7, 8, 10, 12]:
        dagen_in_maand = 31
    elif maand in [4, 6, 9, 11]:
        dagen_in_maand = 30
    else:
        dagen_in_maand = 28

    fractie = (dag - 1) / dagen_in_maand
    return round((begin + ((eind - begin) * fractie)))


def aan_bij_overschot_w():
    return -pv_zonnig_vermogen()


def uit_bij_netafname_w():
    return -pv_zonnig_vermogen() + 2300


@state_trigger(
    "sensor.p1_meter_power not in ['unknown', 'unavailable', None] and "
    "sensor.p1_meter_power.old not in ['unknown', 'unavailable', None] and "
    "float(sensor.p1_meter_power) < aan_bij_overschot_w() and "
    "float(sensor.p1_meter_power.old) >= aan_bij_overschot_w()"
)
def _aan_edge():
    if state.get("binary_sensor.bewoond") != "on":
        return
    if state.get("input_boolean.boiler_al_verwarmd") != "off":
        return
    if state.get("switch.boiler_stopcontact_1") != "off":
        return
    if state.get("timer.boiler_opwarmtijd") != "paused":
        return

    service.call("switch", "turn_on", entity_id="switch.boiler_stopcontact_1")
    service.call("timer", "start", entity_id="timer.boiler_opwarmtijd")


@state_trigger(
    "sensor.p1_meter_power not in ['unknown', 'unavailable', None] and "
    "sensor.p1_meter_power.old not in ['unknown', 'unavailable', None] and "
    "float(sensor.p1_meter_power) > uit_bij_netafname_w() and "
    "float(sensor.p1_meter_power.old) <= uit_bij_netafname_w()"
)
def _uit_edge():
    if state.get("switch.boiler_stopcontact_1") != "on":
        return
    if datetime.now().time() >= time(15, 0):
        return

    if state.get("timer.boiler_opwarmtijd") == "active":
        service.call("timer", "pause", entity_id="timer.boiler_opwarmtijd")
    elif state.get("timer.boiler_opwarmtijd") == "idle":
        service.call("input_boolean", "turn_on", entity_id="input_boolean.boiler_al_verwarmd")

    service.call("switch", "turn_off", entity_id="switch.boiler_stopcontact_1")


@time_trigger("cron(0 6 * * *)")
async def _reset_0600():
    service.call("switch", "turn_off", entity_id="switch.boiler_stopcontact_1")
    await task.sleep(2)
    service.call("input_boolean", "turn_off", entity_id="input_boolean.boiler_al_verwarmd")
    service.call("timer", "start", entity_id="timer.boiler_opwarmtijd", duration=DAG_TIMER)
    await task.sleep(1)
    service.call("timer", "pause", entity_id="timer.boiler_opwarmtijd")


@event_trigger("timer.finished")
def _timer_klaar(**kwargs):
    if (kwargs.get("data") or {}).get("entity_id") != "timer.boiler_opwarmtijd" and kwargs.get("entity_id") != "timer.boiler_opwarmtijd":
        return

    service.call("input_boolean", "turn_on", entity_id="input_boolean.boiler_al_verwarmd")
    service.call("switch", "turn_off", entity_id="switch.boiler_stopcontact_1")


@time_trigger("cron(0 15 * * 3-7)")
async def _forced_1500():
    if state.get("binary_sensor.bewoond") != "on":
        return

    service.call("switch", "turn_on", entity_id="switch.boiler_stopcontact_1")
    await task.sleep(15 * 60)
    service.call("switch", "turn_off", entity_id="switch.boiler_stopcontact_1")


@event_trigger("homeassistant_started")
def _ha_start(event_name=None, data=None, kwargs=None):
    v = state.get("sensor.p1_meter_power")
    try:
        p1 = float(v)
    except (TypeError, ValueError):
        return

    if p1 > uit_bij_netafname_w() and state.get("switch.boiler_stopcontact_1") == "on" and datetime.now().time() < time(15, 0):
        if state.get("timer.boiler_opwarmtijd") == "active":
            service.call("timer", "pause", entity_id="timer.boiler_opwarmtijd")
        elif state.get("timer.boiler_opwarmtijd") == "idle":
            service.call("input_boolean", "turn_on", entity_id="input_boolean.boiler_al_verwarmd")
        service.call("switch", "turn_off", entity_id="switch.boiler_stopcontact_1")

    if p1 < aan_bij_overschot_w():
        if state.get("binary_sensor.bewoond") != "on":
            return
        if state.get("input_boolean.boiler_al_verwarmd") != "off":
            return
        if state.get("switch.boiler_stopcontact_1") != "off":
            return
        if state.get("timer.boiler_opwarmtijd") != "paused":
            return

        service.call("switch", "turn_on", entity_id="switch.boiler_stopcontact_1")
        service.call("timer", "start", entity_id="timer.boiler_opwarmtijd")


@time_trigger("startup", "cron(0 * * * *)")
def update_pv_zonnig_vermogen_sensor():
    waarde = pv_zonnig_vermogen()
    state.set(
        "sensor.pv_zonnig_vermogen_schatting",
        value=waarde,
        new_attributes={
            "friendly_name": "PV zonnig vermogen schatting",
            "unit_of_measurement": "W",
            "maart_ref": 2050,
        },
    )